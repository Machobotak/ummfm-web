# Audio stream SHOUTcast mount. Dibaca lib/stream.ts (STREAM_URL) sebagai fallback
# bila CMS (site_settings.stream_url) belum diisi.
NEXT_PUBLIC_STREAM_URL="https://i.klikhost.com/8682/;radio"

# Supabase (hosted). Isi di .env.local; .env.example hanya dokumentasi.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key — JANGAN ekspos ke browser>"
